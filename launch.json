{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Flask — MediSmart AI",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "MediSmart/app.py",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--host=0.0.0.0",
                "--port=5000"
            ],
            "jinja": true,
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open MediSmart in Chrome",
            "url": "http://localhost:5000",
            "webRoot": "${workspaceFolder}/MediSmart/static"
        }
    ],
    "compounds": [
        {
            "name": "🚀 Flask + Chrome (MediSmart)",
            "configurations": [
                "Run Flask — MediSmart AI",
                "Open MediSmart in Chrome"
            ]
        }
    ]
}
